# Copiar a .env (run_benchmarks.sh lo hace solo si no existe). No subir .env al repositorio.

# Puertos expuestos solo en 127.0.0.1
MONGO_PORT=27017
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090

# Credenciales de PRUEBA, solo para este experimento local
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=abarrotes
MONGO_DB=abarrotes

# Núcleos de la VM de Docker (ADR-003): el motor, el runner y la telemetría no comparten CPU.
# Valores para 16 CPUs lógicos (i7-13620H). Con menos CPUs, ajustar; DB_CPUSET debe tener >= 4 CPUs (perfil A).
DB_CPUSET=0-3
RUNNER_CPUSET=4-11
MONITOR_CPUSET=12-15
